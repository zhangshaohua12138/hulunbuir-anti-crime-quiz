[Unit]
Description=Hulunbuir quiz health monitor
After=network.target hulunbuir-quiz.service

[Service]
Type=oneshot
User=quiz
Group=quiz
EnvironmentFile=-/etc/hulunbuir-quiz-monitor.env
Environment=MONITOR_URL=http://127.0.0.1:8080/api/health
Environment=MONITOR_LOG=/var/lib/hulunbuir-quiz/monitor.log
ExecStart=/opt/hulunbuir-quiz/.venv/bin/python /opt/hulunbuir-quiz/scripts/monitor.py
Nice=10