# 示例配置；启动前以进程环境变量设置，服务不会自动读取此文件。
APP_MODE=production
HOST=127.0.0.1
PORT=8080
# 正式环境必须修改，至少16字符
ADMIN_PASSWORD=
PUBLIC_URL=https://quiz.example.com
DATABASE_PATH=/data/quiz.db
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# gateway 或 wechat_redpack（需商户已开通现金红包产品）
PAYMENT_PROVIDER=gateway
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_CERT_PATH=/secrets/apiclient_cert.pem
WECHAT_KEY_PATH=/secrets/apiclient_key.pem
WECHAT_CLIENT_IP=
WECHAT_SEND_NAME=
WECHAT_ACT_NAME=
WECHAT_WISHING=

# 微信/支付参数也可在后台“微信配置”页维护；以下环境变量作为兜底。
